# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=
LOG_LEVEL=

# --- Database (compose overrides POSTGRES_HOST=db for the api container; host tools use localhost) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Model artifacts / replay (compose sets container paths) ---
ARTIFACTS_DIR=
REPLAY_DIR=
MODEL_VERSION=

# --- Policy bands (0-1000 score) ---
THRESHOLD_STEP_UP=
THRESHOLD_REVIEW=
THRESHOLD_DECLINE=

# --- Graph uplift ---
UPLIFT_KNOWN_FRAUD_2HOP=
UPLIFT_COMPONENT_SIZE=
UPLIFT_COMPONENT_SIZE_MIN=
UPLIFT_NAMES_PER_DEVICE=
UPLIFT_NAMES_PER_DEVICE_MIN=
GRAPH_MAX_NODES=

# --- Drift / replay ---
DRIFT_TIGHTEN_DELTA=
ADWIN_DELTA=
LABEL_LAG_EVENTS=
REPLAY_RATE_PER_SEC=

# --- Security ---
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=
DEMO_ANALYST_USERNAME=
DEMO_ANALYST_PASSWORD=
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=
RATE_LIMIT_DEFAULT=
RATE_LIMIT_LOGIN=
MAX_BODY_BYTES=

# --- LLM (Lane B) ---
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=

# --- Data download (Lane B) ---
KAGGLE_API_TOKEN=
